# Copy to .env.local for local overrides. Everything has a dev default, so this file is optional locally.

# Neon Postgres URL. Set automatically on Vercel by the Neon integration.
# Leave unset locally to use the embedded PGlite database in ./.pglite
# DATABASE_URL=postgresql://...

# The password both Abbots type at /abbot. Dev default: "abbot". REQUIRED in production.
ABBOT_SECRET=

# Signs login cookies. Any long random string (e.g. `openssl rand -base64 32`). REQUIRED in production.
SESSION_SECRET=
